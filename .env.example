# =============================================================================
# Attention-Aware Timeline - Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME=attention-aware-timeline
LOG_LEVEL=INFO
TZ=UTC

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# -----------------------------------------------------------------------------
# Backend (FastAPI)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aat_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=attention_aware_timeline
DATABASE_URL=postgresql+asyncpg://aat_user:change_me_strong_password@postgres:5432/attention_aware_timeline
DATABASE_URL_SYNC=postgresql://aat_user:change_me_strong_password@postgres:5432/attention_aware_timeline

# JWT Authentication
JWT_SECRET_KEY=change_me_to_a_very_long_random_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
AI_HOST=0.0.0.0
AI_PORT=8001
AI_WORKERS=2
AI_MODEL_PATH=/app/models
AI_DEVICE=cpu
# AI_DEVICE=cuda  # uncomment if GPU available
AI_MEDIAPIPE_MODEL_COMPLEXITY=1
AI_CONFIDENCE_THRESHOLD=0.5
AI_MAX_FACES=1
AI_FRAME_SKIP=2

# -----------------------------------------------------------------------------
# Redis (optional - for caching / rate limiting / sessions)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Monitoring & Observability (optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_ATTENTION_TRACKING=true
ENABLE_GAZE_ESTIMATION=true
ENABLE_EMOTION_DETECTION=false
ENABLE_WEBSOCKET=true
